# ---------------------------------------------------------------------------
# Kaushal Parinam (SIH26135) — repository ignore rules
#
# What is tracked: application code, templates, static assets, Docker and
# dependency files.
# What is not tracked: secrets, generated artefacts, local databases, agent
# tooling, and the SIH26135 documentation set (it lives on disk for the team
# but is not pushed to GitHub).
# ---------------------------------------------------------------------------

# --- Documentation: excluded from the source-code push ---------------------
# The PRD, TRD, APP-FLOW, UI-UX, BACKEND-SCHEMA, IMPLEMENTATION-PLAN, SRS,
# Architecture, Slides, Research Report and this build plan stay local.
docs/

# --- Secrets and local configuration ---------------------------------------
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.python-version

# --- Django -----------------------------------------------------------------
# The local SQLite fallback database is generated, never committed.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
db.sqlite3

# Generated by `collectstatic`; the source templates under static/ ARE tracked.
/staticfiles/

# Uploaded files from the CSV intake flow.
/media/

# Rotated application logs.
/logs/
*.log

# --- Local PostgreSQL cluster (docs/10-BUILD-PLAN.md A-01) -----------------
/.pgdata/
/.pglog/

# --- Test and type-check caches ---------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Agent and editor tooling ----------------------------------------------
# Worktrees and scratch state written by coding agents. A worktree left behind
# holds a full stale copy of the project, which is why these are ignored rather
# than committed and re-discovered later.
.kilo/
.freebuff/
.claude/
.agents/
aider.conf.yml
.opencode/
*.code-workspace

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Deployment secrets -----------------------------------------------------
*.pem
*.key