# Kaushal Parinam Environment Variables
# Based on TRD §9 and AGENT-INSTRUCTIONS.md

# Django Settings
SECRET_KEY=django-insecure-dev-key-do-not-use-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_HOST=localhost
DB_PORT=5432
DB_ATOMIC_REQUESTS=True

# DPDP Compliance
DPDP_ACTIVE_FROM=2027-05-13
DPDP_CHILD_AGE_LIMIT=18
DPDP_LANGUAGE_EN=English
DPDP_LANGUAGE_HI=Hindi
DPDP_LANGUAGE_MR=Marathi

# Feature Flags
F08_SIMPLIFIED_MVP=True
F08_DEPARTMENT_CALLS_DEFERRED=True

# WhatsApp / SMS
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_VERIFY_TOKEN=your_verify_token
META_WHATSAPP_ACCESS_TOKEN=your_access_token
TRAI_DLT_ENTITY_ID=your_dlt_entity_id
TRAI_DLT_TEMPLATE_NAME=your_template_name

# Government API Endpoints (mock/simulated for demo)
SIDH_BASE_URL=https://staging.skillindiadigital.gov.in
MAHASWAYAM_BASE_URL=https://rojgar.mahaswayam.gov.in
NCS_BASE_URL=https://ncs.gov.in

# Cost Model (vendor-reported, ⚠ unverified)
WHATSAPP_UTILITY_RATE=0.115  # ₹ per template message (1 Jan 2026)
WHATSAPP_MARKETING_RATE=0.8631  # ₹ per template message (1 Jan 2026)
CALLER_RATE_PER_HOUR=500  # Assumption: ₹500/hr for follow-up calls
MAX_TRAINEES_YEAR=100000  # Design ceiling: ~10 lakh trainees/yr

# Hosting
HOSTING_ENV=docker  # or nicloud for production
DOCKER_COMPOSE_FILE=docker-compose.yml

# Admin and Accounts
ADMIN_URL_PATH=admin/
DEFAULT_RETENTION_BREAK_DAYS=60
DEFAULT_SKILL_GAP_THRESHOLD=2
