# Kaushal Parinam — environment variables
#
# Copy to .env and fill in:   cp .env.example .env
#
# This file lists exactly the variables the project reads, and nothing else.
# Every name below appears in config/settings.py or core/env.py. A variable that
# is not listed here is not read by the code, so adding one has no effect.
# Full variable list and rationale: docs/02-TRD.md §9.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Required in production. Never commit a real key.
SECRET_KEY=
# False for production. DEBUG=True exposes detailed error pages.
DEBUG=True
# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL 15+ is required for Row-Level Security and FOR UPDATE SKIP LOCKED.
# Leave DATABASE_URL empty to fall back to SQLite (development only, no RLS).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/kaushal_parinam
DB_NAME=db.sqlite3             # SQLite fallback filename, relative to the repo root
DB_SSL=False                   # True when PostgreSQL requires TLS
DB_SSLMODE=require
CONN_MAX_AGE=60                # seconds to keep a connection open

# ---------------------------------------------------------------------------
# HTTPS hardening
# ---------------------------------------------------------------------------
# The three *_SECURE flags default to the negation of DEBUG, so they only need
# setting explicitly when running behind TLS termination with DEBUG on.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0          # 31536000 once the domain is HTTPS-only
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False    # True behind traefik or nginx

# ---------------------------------------------------------------------------
# Internationalisation and timezone
# ---------------------------------------------------------------------------
DJANGO_LANGUAGE_CODE=en        # en | hi | mr
DJANGO_TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Email — console backend for the demo
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@kaushal-parinam.local

# ---------------------------------------------------------------------------
# Policy settings
# ---------------------------------------------------------------------------
# Each of these is also editable at runtime in the definitions registry
# (docs/01-PRD.md F-03). The environment values are the seed defaults.
INTERNAL_UTID_PREFIX=KO        # UTID format becomes KO-YYYYMMDD-NNNN
MIN_GROUP_SIZE=5               # k-anonymity floor; smaller dashboard cells are withheld
SKILL_GAP_THRESHOLD=2          # of the 3 signals that must agree before a course is flagged
RETENTION_DEFAULT_BREAK_DAYS=60            # break rule for "retained"
RETENTION_DEFAULT_MIN_EMPLOYMENT_DAYS=365  # employed days required to count as retained
CONSENT_WITHDRAWAL_STOP=True   # False lets messages continue after withdrawal (not recommended)
DPDP_CHILD_AGE_LIMIT=18        # below this, verifiable guardian consent is required
AGEING_SNAPSHOT_DAYS=90        # demand snapshots older than this are flagged stale

# ---------------------------------------------------------------------------
# F-08 random call-back sample
# ---------------------------------------------------------------------------
F08_SIMPLIFIED_MVP=True        # sample is drawn and weighted; the calls are Pilot-phase
NON_REPLIER_SAMPLE_RATE=0.10
CLAIMED_JOB_SAMPLE_RATE=0.05

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
DEMO_REPLY_PROBABILITY=0.25    # NCVER 2024 benchmark range is 20-30%

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
CSV_MAX_UPLOAD_BYTES=10485760  # 10 MB (docs/02-TRD.md §3)

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------
# There is deliberately no credential here. WhatsApp, SMS and IVR are all demo
# stubs in core/adapters/channels.py; none of them reads a token or opens a
# network connection, and every screen labels them SANDBOX / STUB / SIMULATED.
# Add credentials only when a real BSP integration is onboarded.