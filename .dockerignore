# Keep the build context small and free of local state. Without this, `COPY . .`
# ships the 91MB local PostgreSQL cluster, the .env holding the database
# password, logs, and the whole git history into the image.

# Local state
.pgdata/
.pglog/
logs/
staticfiles/
media/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Secrets and local config
.env
.env.*
!.env.example

# VCS and editor
.git/
.gitignore
.github/
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Tooling directories that are not part of the app
.claude/
.agents/
.freebuff/
.opencode/
.idea/
*.code-workspace